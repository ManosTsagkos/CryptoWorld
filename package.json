{
  "name": "cryptoworld",
  "version": "0.1.3",
  "description": "A full-stack crypto market-intelligence dashboard with resilient data fallbacks, technical analysis and optional AI insights.",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:portfolio": "node scripts/build-portfolio.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets:check": "node scripts/check-secrets.mjs",
    "test": "npm run test:unit && npm run test:smoke",
    "test:unit": "node --test tests/config-contract.test.mjs tests/unit/*.test.mjs",
    "test:smoke": "npm run build && node --test tests/rendered-html.test.mjs",
    "check": "npm run secrets:check && npm run format:check && npm run lint && npm run typecheck && npm run test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply top-crypto-signals-db --local",
    "types:cloudflare": "wrangler types types/cloudflare-runtime.d.ts --include-env false --include-runtime true"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.25.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.185.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@tailwindcss/postcss": "4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.185.1",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "1.0.1",
    "vite": "8.3.2",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    },
    "satori": {
      "fflate": "0.8.3"
    }
  },
  "type": "module"
}
