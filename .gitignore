# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.dev.vars
.dev.vars.*
!.dev.vars.example
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/

# local-only project helpers and working assets
/.local/
/.local-assets/
/wrangler-cli-helper.toml
/wrangler.migrations.jsonc
/app/index.ts
/aiinsights.png
/marketpulse.png
/.npmrc

# A Sites deployment is optional and belongs to the local owner's project.
/.openai/hosting.json

# Local Netlify folder
.netlify
